#===============================================================================
# Battle Fantasia Style RPG System - Universal Module (v2)
# Save file goes to the main game /save/ folder
# Ikemen GO zss module
#===============================================================================
[StateDef -4]
ignoreHitPause if isHelper {
} else {
  # ============================================================
  # PLAYER SIDE (Human)
  # ============================================================
  if AILevel = 0 && teamSide = 1 {

    # Load from main save folder
    if map(_rpg_loaded) = 0 {
      loadFile{
        savedata: map;
        path: "../../save/rpg_data.gob";
      }
      map(_rpg_loaded) := 1;
    }

    # Defaults
    if map(rpg_level) <= 0 {
      map(rpg_level)     := 1;
      map(rpg_exp)       := 0;
      map(rpg_exp_next)  := 18;
      map(rpg_atk)       := 100;
      map(rpg_def)       := 100;
    }

    # Apply attack / defence multipliers
    attackMulSet{value: map(rpg_atk) / 100.0}
    defenceMulSet{value: 100.0 / map(rpg_def)}

    # ===== HIT TRACKING (used to detect debug/F1 instant-KO wins) =====
    # F1 in Ikemen's debug keys sets p2's life to 0 directly - it isn't a
    # real win, so a "win" with zero landed hits this round is treated as
    # invalid and earns no EXP.
    if roundState <= 1 {
      map(_hits_landed)  := 0;
      map(_prev_contact) := 0;
    }
    if moveContact = 1 && map(_prev_contact) = 0 {
      map(_hits_landed) := map(_hits_landed) + 1;
    }
    map(_prev_contact) := ifelse(moveContact = 1, 1, 0);

    # ===== EXP GAIN =====
    # Rules:
    #   Draw / no-decision round     -> 0 EXP
    #   Win with 0 hits landed (F1)  -> 0 EXP (debug/invalid win)
    #   Lose                         -> small EXP (still progresses)
    #   Win (normal)                 -> medium EXP
    #   Win (hyper / special)        -> big EXP
    if roundState = 4 && time = 1 {

      map(_gained_exp) := 0;

      if win {
        if map(_hits_landed) = 0 {
          # Debug/F1 instant-KO: not a real win, no EXP
          map(_gained_exp) := 0;
          text{
            removetime: 150;
            text: "No EXP (Debug KO)";
            font: 0;
            pos: 160, 70;
            align: 0;
            scale: 2.1, 2.1;
            layerno: 2;
          }
        } else {
          if winHyper || winSpecial {
            map(_gained_exp) := 12;
            text{
              removetime: 150;
              text: "Hyper Finish! +12 EXP";
              font: 0;
              pos: 260, 270;
              align: 0;
              scale: 2.1, 2.1;
              layerno: 2;
            }
          } else {
            map(_gained_exp) := 7;
            text{
              removetime: 150;
              text: "+7 EXP";
              font: 0;
              pos: 160, 70;
              align: 0;
              scale: 2.1, 2.1;
              layerno: 2;
            }
          }
        }
      } else {
        if lose {
          map(_gained_exp) := 3;
          text{
            removetime: 150;
            text: "+3 EXP";
            font: 0;
            pos: 160, 70;
            align: 0;
            scale: 2.1, 2.1;
            layerno: 2;
          }
        }
        # drawGame (a.k.a. no-decision round) intentionally falls through
        # with _gained_exp left at 0 and no popup text.
      }

      if map(_gained_exp) > 0 {
        map(rpg_exp) := map(rpg_exp) + map(_gained_exp);
      }

      # ===== LEVEL UP (single popup even for multi-level jumps) =====
      map(_levels_gained) := 0;
      while map(rpg_exp) >= map(rpg_exp_next) {
        map(rpg_exp)       := map(rpg_exp) - map(rpg_exp_next);
        map(rpg_level)     := map(rpg_level) + 1;
        map(rpg_atk)       := map(rpg_atk) + 3;
        map(rpg_def)       := map(rpg_def) + 2;
        map(rpg_exp_next)  := 18 + (map(rpg_level) * 6);
        map(_levels_gained):= map(_levels_gained) + 1;
      }
      if map(_levels_gained) = 1 {
        text{
          removetime: 180;
          text: "LEVEL UP!";
          font: 0;
          pos: 360, 340;
          align: 0;
          scale: 3.5, 3.5;
          layerno: 2;
        }
      }
      if map(_levels_gained) > 1 {
        text{
          removetime: 180;
          text: "LEVEL UP x%d!";
          params: map(_levels_gained);
          font: 0;
          pos: 360, 340;
          align: 0;
          scale: 3.5, 3.5;
          layerno: 2;
        }
      }

      # Save to main save folder
      saveFile{
        savedata: map;
        path: "../../save/rpg_data.gob";
      }
    }

    # ===== BOTTOM HUD =====
    if roundState >= 2 {
      text{
        removetime: 2;
        text: "Lv.%d   EXP %d/%d   STR %d   DEF %d";
        params: map(rpg_level), map(rpg_exp), map(rpg_exp_next), map(rpg_atk), map(rpg_def);
        font: -1;
        pos: 10, screenHeight - 86;
        align: 1;
        scale: 1.0, 1.0;
        layerno: 2;
      }
    }
  }

  # ============================================================
  # CPU SIDE
  # ============================================================
  if AILevel > 0 {

    if map(_cpu_scaled) = 0 && roundState <= 1 {

      # Read (not overwrite) the human player's current stats so CPU
      # difficulty tracks how strong the player has actually grown.
      loadFile{
        savedata: map;
        path: "../../save/rpg_data.gob";
      }
      map(_player_atk) := ifelse(map(rpg_atk) > 0, map(rpg_atk), 100);
      map(_player_def) := ifelse(map(rpg_def) > 0, map(rpg_def), 100);

      # ----- Tier from arcade.maxmatches = 6,1,1,0,0,0,0,0,0,0 -----
      # matchno 1-6  -> tier 1 (grunts)
      # matchno 7    -> tier 2 (sub-boss)
      # matchno 8+   -> tier 3 (final boss, toughest overall)
      map(_match) := ifelse(matchno > 0, matchno, 1);
      if map(_match) <= 6 {
        map(_tier) := 1;
      } else {
        if map(_match) = 7 {
          map(_tier) := 2;
        } else {
          map(_tier) := 3;
        }
      }

      # Tier base multiplier (applied on top of the player's own stats)
      if map(_tier) = 1 { map(_tier_mult) := 0.90; }
      if map(_tier) = 2 { map(_tier_mult) := 1.15; }
      if map(_tier) = 3 { map(_tier_mult) := 1.45; }

      # Small per-fight randomness so same tier doesn't feel identical
      map(_rand_atk) := 0.95 + (random / 1000.0 * 0.15);
      map(_rand_def) := 0.95 + (random / 1000.0 * 0.15);
      map(_rand_hp)  := 0.95 + (random / 1000.0 * 0.15);

      map(rpg_atk) := floor(map(_player_atk) * map(_tier_mult) * map(_rand_atk));
      map(rpg_def) := floor(map(_player_def) * map(_tier_mult) * map(_rand_def));
      map(rpg_hp)  := floor(1000 * map(_tier_mult) * map(_rand_hp));

      map(_cpu_scaled) := 1;
    }

    if map(_cpu_scaled) = 1 {
      attackMulSet{value: map(rpg_atk) / 100.0}
      defenceMulSet{value: 100.0 / map(rpg_def)}
      if roundState <= 1 {
        ModifyPlayer{lifemax: map(rpg_hp)}
        lifeSet{value: map(rpg_hp)}
      }
    }
  }
}
